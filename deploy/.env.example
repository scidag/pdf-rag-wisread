POSTGRES_DB=wisread
POSTGRES_USER=wisread
POSTGRES_PASSWORD=wisread123
POSTGRES_PORT=5433
MINIO_ROOT_USER=wisread
MINIO_ROOT_PASSWORD=wisread123
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ENDPOINT=http://localhost:9002
MINIO_BUCKET=wisread-documents
REDIS_PORT=6379

# ---- AI 模型（DashScope 原生协议）----
# 百炼平台 API Key（https://bailian.console.aliyun.com）
DASHSCOPE_API_KEY=
# DashScope 原生协议域名（严禁带 /compatible-mode，SDK 自行拼接 /api/v1/services/...）
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com

# ---- L2 长期用户记忆 ----
# 总开关：关闭时记忆注入与提取均旁路（零开销）
WISREAD_USER_MEMORY_ENABLED=true
# 提取独立开关（注入稳定前可只读不写）
WISREAD_USER_MEMORY_EXTRACT_ENABLED=true

# ---- 认证安全配置（FR-4）----
# 当前 JWT 签名密钥（签发+校验）：openssl rand -base64 48
# 为空或为弱默认值时后端启动即失败（fail-fast）
JWT_SECRET_CURRENT=
# 上一代密钥（仅校验，可空）：密钥轮换时填入旧值实现无感切换，旧令牌（≤24h）消亡后清空
JWT_SECRET_PREVIOUS=
# 会话密文密钥（FR-8 宽限重发，AES-256-GCM）：openssl rand -base64 32
# 为空或长度不符时后端启动即失败
SESSION_CIPHER_KEY=
# 会话存储模式（FR-7）：postgres | redis-migrate | redis
WISREAD_SESSION_STORE_MODE=postgres
# 是否信任反向代理的 X-Forwarded-For（仅部署于可信代理后开启）
WISREAD_TRUST_PROXY=false
